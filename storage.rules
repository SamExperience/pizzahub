rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Profile of the signed-in user (users/{uid}), read from Firestore.
    function userProfile() {
      return firestore.get(
        /databases/(default)/documents/users/$(request.auth.uid)
      ).data;
    }

    function userStoreId() {
      return userProfile().storeId;
    }

    // V1 has a single role: only admins may write product images.
    function isAdmin() {
      return userProfile().role == "admin";
    }

    // Product images live under products/{storeId}/. Any user of the store
    // can read them; only the store's admin can create, update or delete.
    // Uploads are small WebP/JPEG files compressed in the browser
    // (src/utils/productImage.js): under 150 KB, no other content type.
    match /products/{storeId}/{allPaths=**} {
      allow read: if request.auth != null
        && userStoreId() == storeId;

      allow delete: if request.auth != null
        && isAdmin()
        && userStoreId() == storeId;

      allow create, update: if request.auth != null
        && isAdmin()
        && userStoreId() == storeId
        && request.resource.size < 150 * 1024
        && request.resource.contentType in ['image/webp', 'image/jpeg'];
    }
  }
}
