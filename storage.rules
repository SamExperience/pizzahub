rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function userStoreId() {
      return firestore.get(
        /databases/(default)/documents/users/$(request.auth.uid)
      ).data.storeId;
    }

    // Product images live under products/{storeId}/ and are limited to the
    // store of the signed-in user (profile read from Firestore).
    match /products/{storeId}/{allPaths=**} {
      allow read, delete: if request.auth != null
        && userStoreId() == storeId;

      allow create, update: if request.auth != null
        && userStoreId() == storeId
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
