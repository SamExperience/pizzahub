{
  "source": {
    "include": ["src", "functions"],
    "includePattern": ".+\\.jsx?$",
    "excludePattern": "(node_modules|\\.test\\.jsx?$|vitest\\.config\\.js$|setupTests\\.js$)"
  },
  "recurseDepth": 10,
  "opts": {
    "destination": "docs/",
    "recurse": true,
    "encoding": "utf8"
  },
  "plugins": ["plugins/markdown"]
}
