rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Field limits. They mirror FIELD_LIMITS in src/utils/fieldLimits.js and
    // must be kept in sync with it. A required text is non-blank: the RE2
    // regex must fully match whitespace-only (or empty) strings to reject them.
    // The length of single list elements is not checked here.
    function isName(v) {
      return v is string && v.size() <= 100 && !v.matches('\\s*');
    }

    function isAddressLine(v) {
      return v is string && v.size() <= 100 && !v.matches('\\s*');
    }

    function isPostalCode(v) {
      return v is string && v.size() <= 20 && !v.matches('\\s*');
    }

    // Optional strings: null, or a string within the limit.
    function isOptName(v) {
      return v == null || (v is string && v.size() <= 100);
    }

    function isOptAddressLine(v) {
      return v == null || (v is string && v.size() <= 100);
    }

    function isOptStreetNumber(v) {
      return v == null || (v is string && v.size() <= 20);
    }

    function isOptPostalCode(v) {
      return v == null || (v is string && v.size() <= 20);
    }

    // Company address: optional, every part null or a string within its limit.
    function isValidCompanyAddress(v) {
      return v == null
        || (v is map
          && v.keys().hasOnly([
            "street", "streetNumber", "postalCode", "city", "country"
          ])
          && isOptAddressLine(v.get("street", null))
          && isOptStreetNumber(v.get("streetNumber", null))
          && isOptPostalCode(v.get("postalCode", null))
          && isOptAddressLine(v.get("city", null))
          && isOptAddressLine(v.get("country", null)));
    }

    // Store address: required, street, postalCode, city and country non-blank.
    function isValidStoreAddress(v) {
      return v is map
        && v.keys().hasOnly([
          "street", "streetNumber", "postalCode", "city", "country"
        ])
        && v.keys().hasAll(["street", "postalCode", "city", "country"])
        && isAddressLine(v.street)
        && isOptStreetNumber(v.get("streetNumber", null))
        && isPostalCode(v.postalCode)
        && isAddressLine(v.city)
        && isAddressLine(v.country);
    }

    function isValidCompany(data) {
      return data.keys().hasOnly([
          "name", "logoUrl", "address", "createdAt", "updatedAt"
        ])
        && data.keys().hasAll([
          "name", "logoUrl", "address", "createdAt", "updatedAt"
        ])
        && isName(data.name)
        && (data.logoUrl == null || data.logoUrl is string)
        && isValidCompanyAddress(data.address)
        && data.createdAt == request.time
        && data.updatedAt == request.time;
    }

    function isValidStore(data) {
      return data.keys().hasOnly([
          "companyId", "name", "address", "isActive", "imageUrl",
          "createdAt", "updatedAt"
        ])
        && data.keys().hasAll([
          "companyId", "name", "address", "isActive", "imageUrl",
          "createdAt", "updatedAt"
        ])
        && data.companyId is string
        && isName(data.name)
        && isValidStoreAddress(data.address)
        && data.isActive is bool
        && (data.imageUrl == null || data.imageUrl is string)
        && data.createdAt == request.time
        && data.updatedAt == request.time;
    }

    // displayName is optional (it can be null).
    function isValidUser(data) {
      return data.keys().hasOnly([
          "uid", "companyId", "storeId", "role", "displayName",
          "createdAt", "updatedAt"
        ])
        && data.keys().hasAll([
          "uid", "companyId", "storeId", "role", "createdAt", "updatedAt"
        ])
        && data.uid is string
        && data.companyId is string
        && data.storeId is string
        && isOptName(data.get("displayName", null))
        && data.createdAt == request.time
        && data.updatedAt == request.time;
    }

    match /companies/{companyId} {
      allow read: if request.auth != null
        && get(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.companyId == companyId;

      allow create: if request.auth != null
        && getAfter(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.companyId == companyId
        && getAfter(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.role == "admin"
        && isValidCompany(request.resource.data);
    }

    match /stores/{storeId} {
      allow read: if request.auth != null
        && get(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.storeId == storeId;

      allow create: if request.auth != null
        && getAfter(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.storeId == storeId
        && getAfter(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.role == "admin"
        && getAfter(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.companyId == request.resource.data.companyId
        && isValidStore(request.resource.data);
    }

    match /users/{userId} {
      allow read: if request.auth != null
        && userId == request.auth.uid;

      allow create: if request.auth != null
        && userId == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.role == "admin"
        && request.resource.data.companyId != null
        && request.resource.data.storeId != null
        && getAfter(
          /databases/$(database)/documents/companies/$(request.resource.data.companyId)
        ).data.createdAt == request.time
        && getAfter(
          /databases/$(database)/documents/stores/$(request.resource.data.storeId)
        ).data.createdAt == request.time
        && isValidUser(request.resource.data);
    }

    // Profile of the signed-in user (users/{uid}), read once per request.
    function userProfile() {
      return get(
        /databases/$(database)/documents/users/$(request.auth.uid)
      ).data;
    }

    // Store of the signed-in user, read from their profile.
    function userStoreId() {
      return userProfile().storeId;
    }

    // V1 has a single role: every write on business data needs an admin.
    function isAdmin() {
      return userProfile().role == "admin";
    }

    function menuStoreId(menuId) {
      return get(
        /databases/$(database)/documents/menus/$(menuId)
      ).data.storeId;
    }

    function categoryStoreId(categoryId) {
      return menuStoreId(
        get(
          /databases/$(database)/documents/categories/$(categoryId)
        ).data.menuId
      );
    }

    function isValidMenuCreate(data) {
      return data.keys().hasOnly(["storeId", "name", "createdAt", "updatedAt"])
        && data.keys().hasAll(["storeId", "name", "createdAt", "updatedAt"])
        && data.storeId is string
        && isName(data.name)
        && data.createdAt == request.time
        && data.updatedAt == request.time;
    }

    // Legacy Menus may miss a key, so nothing is required here: keys that are
    // present are validated, required keys cannot be removed, and storeId and
    // createdAt never change.
    function isValidMenuUpdate(data) {
      let changed = data.diff(resource.data);

      return data.keys().hasOnly(["storeId", "name", "createdAt", "updatedAt"])
        && !changed.removedKeys().hasAny([
          "storeId", "name", "createdAt", "updatedAt"
        ])
        && !changed.affectedKeys().hasAny(["storeId", "createdAt"])
        && (!data.keys().hasAny(["name"]) || isName(data.name))
        && data.updatedAt == request.time;
    }

    match /menus/{menuId} {
      allow read: if request.auth != null
        && resource.data.storeId == userStoreId();

      allow create: if request.auth != null
        && isAdmin()
        && request.resource.data.storeId == userStoreId()
        && isValidMenuCreate(request.resource.data);

      allow update: if request.auth != null
        && isAdmin()
        && request.resource.data.storeId == resource.data.storeId
        && resource.data.storeId == userStoreId()
        && isValidMenuUpdate(request.resource.data);

      allow delete: if request.auth != null
        && isAdmin()
        && resource.data.storeId == userStoreId();
    }

    match /categories/{categoryId} {
      allow read: if request.auth != null
        && menuStoreId(resource.data.menuId) == userStoreId();

      allow create: if request.auth != null
        && isAdmin()
        && menuStoreId(request.resource.data.menuId) == userStoreId();

      allow update: if request.auth != null
        && isAdmin()
        && request.resource.data.menuId == resource.data.menuId
        && menuStoreId(resource.data.menuId) == userStoreId();

      allow delete: if request.auth != null
        && isAdmin()
        && menuStoreId(resource.data.menuId) == userStoreId();
    }

    match /products/{productId} {
      allow read: if request.auth != null
        && categoryStoreId(resource.data.categoryId) == userStoreId();

      allow create: if request.auth != null
        && isAdmin()
        && categoryStoreId(request.resource.data.categoryId) == userStoreId();

      allow update: if request.auth != null
        && isAdmin()
        && request.resource.data.categoryId == resource.data.categoryId
        && categoryStoreId(resource.data.categoryId) == userStoreId();

      allow delete: if request.auth != null
        && isAdmin()
        && categoryStoreId(resource.data.categoryId) == userStoreId();
    }

    // Company of the signed-in user, read from their profile.
    function userCompanyId() {
      return userProfile().companyId;
    }

    // Customer fields a client may write, and common shape checks.
    function isValidCustomer(data) {
      return data.keys().hasOnly([
          "companyId", "firstName", "lastName", "phone", "address",
          "createdAt", "updatedAt"
        ])
        && data.keys().hasAll(["companyId", "firstName", "createdAt", "updatedAt"])
        && data.firstName is string
        && data.firstName.size() > 0
        && data.updatedAt == request.time;
    }

    // Customer written in the same request (or already stored), after the write.
    function orderCustomer(customerId) {
      return getAfter(
        /databases/$(database)/documents/customers/$(customerId)
      ).data;
    }

    // Delivery needs phone and street, streetNumber, postalCode, city.
    function hasDeliveryDetails(customer) {
      return customer.phone is string
        && customer.phone.size() > 0
        && customer.address is map
        && customer.address.street is string
        && customer.address.street.size() > 0
        && customer.address.streetNumber is string
        && customer.address.streetNumber.size() > 0
        && customer.address.postalCode is string
        && customer.address.postalCode.size() > 0
        && customer.address.city is string
        && customer.address.city.size() > 0;
    }

    // Order content editable on creation and on edit: customer, order type,
    // scheduled time, items and total.
    function isValidOrderContent(data) {
      return data.customerId is string
        && data.orderType in ["takeaway", "delivery"]
        && data.items is list
        && data.items.size() > 0
        && data.total is number
        && data.scheduledTime is timestamp
        && orderCustomer(data.customerId).companyId == userCompanyId()
        && (data.orderType != "delivery"
          || hasDeliveryDetails(orderCustomer(data.customerId)));
    }

    function isValidOrder(data) {
      return data.keys().hasOnly([
          "storeId", "customerId", "orderType", "scheduledTime", "status",
          "items", "total", "createdAt", "updatedAt"
        ])
        && data.keys().hasAll([
          "storeId", "customerId", "orderType", "scheduledTime", "status",
          "items", "total", "createdAt", "updatedAt"
        ])
        && data.storeId == userStoreId()
        && data.status == "Pending"
        && data.createdAt == request.time
        && data.updatedAt == request.time
        && isValidOrderContent(data);
    }

    // Fields changed by the current Order update.
    function orderChangedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // Status change (Cancelled = soft delete). completedAt is the request time
    // when the Order moves to Completed, null when it moves back, and
    // unchanged on cancellation.
    function isOrderStatusChange() {
      let data = request.resource.data;

      return orderChangedKeys().hasOnly(["status", "updatedAt", "completedAt"])
        && (
          (data.status == "Completed" && data.completedAt == request.time)
          || (data.status in ["Pending", "In progress"]
            && data.get("completedAt", null) == null)
          || (data.status == "Cancelled"
            && !orderChangedKeys().hasAny(["completedAt"]))
        );
    }

    // Content edit; status, storeId and createdAt stay unchanged.
    function isOrderContentEdit() {
      return orderChangedKeys().hasOnly([
          "customerId", "orderType", "scheduledTime", "items", "total",
          "updatedAt"
        ])
        && isValidOrderContent(request.resource.data);
    }

    // Orders are never deleted; a Cancelled Order is final.
    match /orders/{orderId} {
      allow read: if request.auth != null
        && resource.data.storeId == userStoreId();

      allow create: if request.auth != null
        && isAdmin()
        && isValidOrder(request.resource.data);

      allow update: if request.auth != null
        && isAdmin()
        && resource.data.storeId == userStoreId()
        && resource.data.status != "Cancelled"
        && request.resource.data.updatedAt == request.time
        && (isOrderStatusChange() || isOrderContentEdit());
    }

    match /customers/{customerId} {
      allow read: if request.auth != null
        && resource.data.companyId == userCompanyId();

      allow create: if request.auth != null
        && isAdmin()
        && request.resource.data.companyId == userCompanyId()
        && isValidCustomer(request.resource.data)
        && request.resource.data.createdAt == request.time;

      allow update: if request.auth != null
        && isAdmin()
        && resource.data.companyId == userCompanyId()
        && request.resource.data.companyId == resource.data.companyId
        && request.resource.data.createdAt == resource.data.createdAt
        && isValidCustomer(request.resource.data);
    }
  }
}
